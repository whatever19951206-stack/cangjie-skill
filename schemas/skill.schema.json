{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangjie-skill.dev/schemas/skill.schema.json",
  "title": "Cangjie machine-readable skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "title",
    "description",
    "source",
    "routing",
    "workflow",
    "boundaries",
    "evidence_refs",
    "verification",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80
    },
    "title": {"type": "string", "minLength": 2, "maxLength": 120},
    "description": {"type": "string", "minLength": 20, "maxLength": 1000},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "type"],
      "properties": {
        "source_id": {"type": "string", "minLength": 2},
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "year": {"type": ["integer", "null"], "minimum": 0},
        "type": {
          "enum": ["book", "video", "podcast", "course", "interview", "article", "document-set"]
        },
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 4},
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 4},
          "uniqueItems": true
        },
        "signals": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "sibling_priority": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["use_when"],
            "properties": {
              "use_when": {"type": "string", "minLength": 4}
            }
          }
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "completion"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "action": {"type": "string", "minLength": 4},
          "completion": {"type": "string", "minLength": 4},
          "stop_if": {"type": "string", "minLength": 4}
        }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 4},
      "uniqueItems": true
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$"},
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faithfulness",
        "evidence_diversity",
        "transferability",
        "separability",
        "risk_level",
        "hard_gate_passed"
      ],
      "properties": {
        "faithfulness": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_diversity": {"type": "number", "minimum": 0, "maximum": 1},
        "transferability": {"type": "number", "minimum": 0, "maximum": 1},
        "uplift": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "separability": {"type": "number", "minimum": 0, "maximum": 1},
        "risk_level": {"enum": ["low", "medium", "high"]},
        "hard_gate_passed": {"type": "boolean"}
      }
    },
    "status": {"enum": ["draft", "tested", "published"]}
  }
}
