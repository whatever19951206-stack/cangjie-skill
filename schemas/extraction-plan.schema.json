{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangjie-skill.dev/schemas/extraction-plan.schema.json",
  "title": "Cangjie Map-Reduce extraction plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "mode", "source_hash", "prompt_version", "chunks", "tasks", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "mode": {"enum": ["scan", "standard", "audit"]},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prompt_version": {"type": "string", "minLength": 1},
    "model_id": {"type": ["string", "null"]},
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "content_hash", "source_ref"],
        "properties": {
          "chunk_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "source_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "stage", "extractor", "dependencies", "cache_key", "status"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
          "stage": {"enum": ["map", "reduce", "merge", "verify"]},
          "extractor": {"type": "string", "minLength": 1},
          "chunk_id": {"type": ["string", "null"]},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
            "uniqueItems": true
          },
          "cache_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["pending", "running", "success", "failed", "skipped"]},
          "artifact": {"type": ["string", "null"]}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
