{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangjie-skill.dev/schemas/evidence.schema.json",
  "title": "Cangjie evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "type"],
      "properties": {
        "source_id": {"type": "string", "minLength": 2},
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "type": {
          "enum": ["book", "video", "podcast", "course", "interview", "article", "document-set"]
        },
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "claim_type", "source_ref", "text", "text_hash"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$"},
          "claim_type": {
            "enum": ["direct_quote", "author_paraphrase", "inferred_method", "model_critique", "external_fact"]
          },
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id"],
            "properties": {
              "source_id": {"type": "string", "minLength": 2},
              "chapter": {"type": "string"},
              "printed_page": {"type": "integer", "minimum": 1},
              "file_page": {"type": "integer", "minimum": 1},
              "paragraph": {"type": "integer", "minimum": 1},
              "timestamp": {"type": "string"},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "external_url": {"type": "string", "format": "uri"}
            },
            "anyOf": [
              {"required": ["chapter"]},
              {"required": ["printed_page"]},
              {"required": ["file_page"]},
              {"required": ["paragraph"]},
              {"required": ["timestamp"]},
              {"required": ["line_start"]},
              {"required": ["external_url"]}
            ]
          },
          "text": {"type": "string", "minLength": 1},
          "text_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "supports": {"type": "string", "minLength": 4},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
