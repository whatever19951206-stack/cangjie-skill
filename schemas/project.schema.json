{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangjie-skill.dev/schemas/project.schema.json",
  "title": "Cangjie project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "mode",
    "pipeline_version",
    "source",
    "goal",
    "limits",
    "requirements",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "mode": {"enum": ["scan", "standard", "audit"]},
    "pipeline_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "type", "source_hash"],
      "properties": {
        "source_id": {"type": "string", "minLength": 2},
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "year": {"type": ["integer", "null"], "minimum": 0},
        "type": {"enum": ["book", "video", "podcast", "course", "interview", "article", "document-set"]},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "goal": {"type": "string", "minLength": 1},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_candidates", "max_skills"],
      "properties": {
        "max_candidates": {"type": "integer", "minimum": 1},
        "max_skills": {"type": "integer", "minimum": 1}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_evaluator", "hidden_evaluation", "external_validation"],
      "properties": {
        "independent_evaluator": {"type": "boolean"},
        "hidden_evaluation": {"type": "boolean"},
        "external_validation": {"type": "boolean"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
